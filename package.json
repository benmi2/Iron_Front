{
  "name": "iron-front",
  "private": true,
  "version": "0.1.0",
  "description": "IRON FRONT - historically grounded WWII 2.5D side-view combined-arms tank warfare (TypeScript + Three.js).",
  "type": "module",
  "scripts": {
